/build*/
/compile_commands.json

# The oksh configure shim's leftovers, and objects if anyone ever
# hand-compiles in src/.
/src/Makefile
/src/pconfig.h
*.o

# Editors and tools
.cache/
.vscode/
.idea/
*.swp
*~
