/* pconfig.h -- generated by CMake from cmake/pconfig.h.in.
 *
 * The same job oksh's configure script does when it writes
 * pconfig.h. Do not edit the generated copy.
 *
 * __dead is guarded: z/OS <sys/cdefs.h> and other systems may already
 * define it, and redefining it is fatal.
 */
#ifndef FSH_PCONFIG_H
#define FSH_PCONFIG_H

/* __dead, defined only if the system does not already have one. The
 * guard is on the definition itself: a system with __dead in
 * <sys/cdefs.h> keeps its own, and everything else gets the GNU
 * attribute. */
#ifndef __dead
#cmakedefine FSH_HAVE_SYSTEM_DEAD
#ifndef FSH_HAVE_SYSTEM_DEAD
#define __dead __attribute__((__noreturn__))
#endif
#endif

#cmakedefine HAVE_ASPRINTF
#cmakedefine HAVE_CONFSTR
#cmakedefine HAVE_GETAUXVAL
#cmakedefine HAVE_REALLOCARRAY
#cmakedefine HAVE_SETRESGID_DECL
#cmakedefine HAVE_SETRESUID_DECL
#cmakedefine HAVE_ASPRINTF_DECL
#cmakedefine HAVE_CONFSTR_DECL
#cmakedefine HAVE_GETAUXVAL_DECL
#cmakedefine HAVE_REALLOCARRAY_DECL
#cmakedefine HAVE_STRLCAT_DECL
#cmakedefine HAVE_STRLCPY_DECL
#cmakedefine HAVE_STRTONUM_DECL
#cmakedefine HAVE_SETRESGID
#cmakedefine HAVE_SETRESUID
#cmakedefine HAVE_PATHS_H
#cmakedefine HAVE_FLOCK
#cmakedefine HAVE_STRSIGNAL
#cmakedefine HAVE_WCOREDUMP
#cmakedefine HAVE_SYS_PARAM_H
#cmakedefine HAVE_MAXLOGNAME
#cmakedefine HAVE_SIG_T
#cmakedefine HAVE_ST_MTIM
#cmakedefine HAVE_STRLCAT
#cmakedefine HAVE_STRLCPY
#cmakedefine HAVE_STRTONUM
#cmakedefine HAVE_TIMERADD
#cmakedefine HAVE_TIMERCLEAR
#cmakedefine HAVE_TIMERSUB
#cmakedefine HAVE_CURSES

#endif /* FSH_PCONFIG_H */
