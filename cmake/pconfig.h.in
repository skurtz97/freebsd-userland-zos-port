/* pconfig.h -- generated by CMake from cmake/pconfig.h.in.
 *
 * The same job oksh's configure script does when it writes
 * pconfig.h. Do not edit the generated copy.
 *
 * __dead is guarded: z/OS <sys/cdefs.h> and other systems may already
 * define it, and redefining it is fatal.
 */
#ifndef ZKSH_PCONFIG_H
#define ZKSH_PCONFIG_H

#ifndef __dead
#cmakedefine01 HAVE___DEAD
#if HAVE___DEAD
#define __dead __attribute__((__noreturn__))
#endif
#endif

#cmakedefine HAVE_ASPRINTF
#cmakedefine HAVE_CONFSTR
#cmakedefine HAVE_GETAUXVAL
#cmakedefine HAVE_REALLOCARRAY
#cmakedefine HAVE_SETRESGID
#cmakedefine HAVE_SETRESUID
#cmakedefine HAVE_SIG_T
#cmakedefine HAVE_ST_MTIM
#cmakedefine HAVE_STRLCAT
#cmakedefine HAVE_STRLCPY
#cmakedefine HAVE_STRTONUM
#cmakedefine HAVE_TIMERADD
#cmakedefine HAVE_TIMERCLEAR
#cmakedefine HAVE_TIMERSUB
#cmakedefine HAVE_CURSES

#endif /* ZKSH_PCONFIG_H */
