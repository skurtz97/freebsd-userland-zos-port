/* Generated for the vendored FreeBSD contrib/libedit. */
/* libedit checks these with #ifdef, so leave a missing header/function
 * undefined rather than defining it to 0. */
#cmakedefine HAVE_CURSES_H 1
#cmakedefine HAVE_NCURSES_H 1
#cmakedefine HAVE_GETPW_R_POSIX 1
#cmakedefine HAVE_GETPW_R_DRAFT 1
#cmakedefine HAVE_ISSETUGID 1
#cmakedefine HAVE_STRUCT_DIRENT_D_NAMLEN 1
#cmakedefine HAVE_SYS_CDEFS_H 1
#cmakedefine HAVE_TERMCAP_H 1
#cmakedefine HAVE_TERM_H 1
#include <stddef.h>
#include <stdint.h>
#include "sys.h"

#if !HAVE_ISSETUGID
/* glibc has no issetugid(); a POSIX programme can compute the answer. */
int fsh_issetugid(void);
#define issetugid() fsh_issetugid()
#endif
/* FreeBSD's <vis.h>; a stub is provided by src/compat/vis.c when the
 * host has no libc version (Linux, z/OS). */
#include <vis.h>
